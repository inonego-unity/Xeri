{
  "metadata": [
    {
      "src": [
      {
        "src": "../..",
        "files": [
          "inonego.Xeri.csproj",
          "inonego.Xeri.Editor.csproj",
          "inonego.Xeri.VFXGraph.csproj",
          "inonego.Xeri.UI.HDRP.csproj",
          "inonego.Xeri.UI.HDRP.Editor.csproj"
        ]
      }
    ],
    "dest": ".docfx/api",
    "noRestore": true,
    "disableGitFeatures": true,
    "includePrivateMembers": false,
    "memberLayout": "samePage",
    "namespaceLayout": "flattened"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["index.md", "toc.yml"]
      },
      {
        "src": "com.inonego.xeri/Documentation~",
        "files": ["**/*.md", "toc.yml", "**/toc.yml"],
        "dest": "docs"
      },
      {
        "src": "com.inonego.xeri/Runtime",
        "files": ["**/README.md"],
        "dest": "runtime"
      },
      {
        "src": "Docs/api-bridge",
        "files": ["*.md"],
        "dest": "api"
      },
      {
        "src": ".docfx/api",
        "files": ["toc.yml", "**/*.yml"],
        "dest": "api"
      }
    ],    "resource": [
      {
        "src": "com.inonego.xeri/Documentation~",
        "files": ["**/*.{png,jpg,jpeg,gif,svg,webp}"] ,
        "dest": "docs"
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Xeri",
      "_appTitle": "Xeri Documentation",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
