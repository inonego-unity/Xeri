.generic-type-picker {
    flex-grow: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: #2b2b2b;
    color: #d6d6d6;
}

.generic-type-caption,
.generic-type-result-caption {
    color: #9c9c9c;
    font-size: 11px;
}

.generic-type-definition {
    -unity-font-style: bold;
    font-size: 13px;
    margin-top: 2px;
    margin-bottom: 10px;
}

.generic-type-arguments-panel {
    flex-grow: 0;
    flex-shrink: 0;
    background-color: #242424;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: #252525;
    border-bottom-color: #252525;
    border-left-color: #252525;
    border-right-color: #252525;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
}

.generic-type-arguments {
    flex-grow: 0;
}

.generic-type-argument-row {
    min-height: 22px;
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

.generic-type-argument-name {
    width: 96px;
    min-width: 96px;
    padding-left: 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.generic-type-argument-button {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 20px;
    margin-left: 0;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.generic-type-argument-button .unity-button__text {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.generic-type-array-toggle {
    width: 58px;
    min-width: 58px;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
}

.generic-type-array-toggle .unity-toggle__label {
    min-width: 0;
    width: auto;
    margin-right: 6px;
}

.generic-type-arguments .xeri-tree-children {
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: #555555;
}

.generic-type-result-row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: flex-start;
    min-height: 24px;
    margin-top: 8px;
}

.generic-type-result-caption {
    width: 64px;
    min-width: 64px;
    margin-top: 2px;
}

.generic-type-result {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    -unity-font-style: bold;
    white-space: normal;
}

.generic-type-status {
    min-height: 18px;
    flex-shrink: 0;
    color: #d6a05c;
    white-space: normal;
}

.generic-type-footer {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: flex-end;
    margin-top: 6px;
}

.generic-type-footer-button {
    width: 84px;
    height: 22px;
    margin-left: 6px;
}

.generic-type-select-button {
    -unity-font-style: bold;
}
