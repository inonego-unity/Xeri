        <ui:VisualElement name="paged-list-toolbar" class="xeri-paged-list__toolbar">
            <ui:VisualElement name="paged-list-toolbar-row" class="xeri-paged-list__toolbar-row">
                <ui:VisualElement name="paged-list-search" class="xeri-paged-list__search-host" />
                <ui:VisualElement name="paged-list-toolbar-actions" class="xeri-paged-list__toolbar-actions" />
            </ui:VisualElement>
            <ui:VisualElement name="paged-list-toolbar-extra" class="xeri-paged-list__toolbar-extra" />
