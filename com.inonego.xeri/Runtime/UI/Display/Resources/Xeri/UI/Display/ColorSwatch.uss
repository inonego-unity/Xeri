/* BLOCK_HEADER_BEGIN =======================================================================
파일명 : ColorSwatch.uss
수정일 : 2026-11-19

# 설명
ColorSwatch 요소의 기본 모양. 상위 요소에 지정한 변수는 상속된다.

  --xeri-color-swatch-size           한 변 길이 (기본 12px)
  --xeri-color-swatch-radius         모서리 둥글기 (기본 2px)
  --xeri-color-swatch-border-color   테두리 색 (기본 반투명 검정)
========================================================================= BLOCK_HEADER_END */

.xeri-color-swatch {
    flex-grow: 0;
    flex-shrink: 0;
    width: var(--xeri-color-swatch-size, 12px);
    height: var(--xeri-color-swatch-size, 12px);
    margin: 0;
    border-width: 1px;
    border-color: var(--xeri-color-swatch-border-color, rgba(0, 0, 0, 0.45));
    border-radius: var(--xeri-color-swatch-radius, 2px);
}
