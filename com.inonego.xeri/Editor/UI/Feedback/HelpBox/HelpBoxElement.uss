.helpbox-root {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.helpbox-root--none { background-color: rgba(178,178,178,0.1); }
.helpbox-root--info { background-color: rgba(128,178,255,0.1); }
.helpbox-root--warning { background-color: rgba(255,204,77,0.1); }
.helpbox-root--error { background-color: rgba(255,77,77,0.1); }

.helpbox-icon {
    width: 16px;
    min-width: 16px;
    height: 16px;
    min-height: 16px;
    padding: 0;
    margin-right: 4px;
    flex-shrink: 0;
    --unity-image-size: scale-to-fit;
}

.helpbox-message {
    flex-grow: 1;
    font-size: 10px;
    white-space: normal;
}
