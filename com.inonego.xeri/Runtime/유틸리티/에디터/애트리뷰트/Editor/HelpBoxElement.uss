/* HelpBox 루트 — 가로 배치, 아이콘과 메시지 정렬 */
.helpbox-root {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* 메시지 타입별 배경색 — 원본 GetBackgroundColor 값 그대로 (alpha 0.1) */
.helpbox-root--none {
    background-color: rgba(178, 178, 178, 0.1);
}

.helpbox-root--info {
    background-color: rgba(128, 178, 255, 0.1);
}

.helpbox-root--warning {
    background-color: rgba(255, 204, 77, 0.1);
}

.helpbox-root--error {
    background-color: rgba(255, 77, 77, 0.1);
}

/* 아이콘 — ICON_SIZE = 16, ICON_PADDING = 4 (right margin) */
.helpbox-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* 메시지 — 워드랩, 폰트 10 */
.helpbox-message {
    flex-grow: 1;
    font-size: 10px;
    white-space: normal;
}
