/* BLOCK_HEADER_BEGIN =======================================================================
파일명 : CollectionEditorViewStyle.uss
수정일 : 2026-10-31

# 설명
Picker의 평평한 툴바·표·하단 페이지 스타일을 Collection Inspector 크기에 맞춰 적용한다.
항목 수가 바뀌어도 목록의 고정 높이와 페이지네이션 위치는 유지한다.
========================================================================= BLOCK_HEADER_END */

/* 접힌 CollectionEditor는 헤더와 항목 수만 남기고 박스 높이를 줄인다. */
.xeri-collection--collapsed,
.xeri-collection--collapsed .xeri-paged-list,
.xeri-collection--collapsed .xeri-paged-list__root {
    flex-grow: 0;
}

.xeri-collection--collapsed .xeri-paged-list__toolbar,
.xeri-collection--collapsed .xeri-paged-list__content,
.xeri-collection--collapsed .xeri-paged-list__status,
.xeri-collection--collapsed .xeri-paged-list__footer {
    display: none;
}

.xeri-collection__foldout-button {
    width: 18px;
    min-width: 18px;
    height: 22px;
    min-height: 22px;
    flex-shrink: 0;
    margin: 0;
    margin-right: 2px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    -unity-text-align: middle-center;
    font-size: 13px;
}

.xeri-collection__foldout-button:hover {
    background-color: rgba(127,127,127,0.18);
}
/* 프레임과 상단 도구 모음 */
/* 공통 셸의 콘텐츠만 Inspector 환경에 맞게 조정한다. */
.xeri-collection .xeri-paged-list__header {
    flex-shrink: 0;
    min-width: 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(127,127,127,0.20);
    background-color: rgba(127,127,127,0.08);
}

.xeri-collection .xeri-paged-list__toolbar {
    padding-left: 5px;
    padding-right: 5px;
    height: 27px;
    min-height: 27px;
    background-color: rgba(127,127,127,0.08);
}

.xeri-collection .xeri-paged-list__content {
    flex-grow: 0;
}

/* Collection Editor는 행별 경고 아이콘만 사용하며 하단 상태 패널은 표시하지 않는다. */
.xeri-collection .xeri-paged-list__status {
    display: none;
}

.xeri-collection .xeri-paged-list__footer {
    min-height: 29px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(127,127,127,0.27);
    border-bottom-color: rgba(127,127,127,0.16);
    background-color: rgba(127,127,127,0.08);
}

.xeri-collection {
    flex-grow: 1;
    min-width: 0;
    margin-top: 3px;
    margin-bottom: 6px;
}

.xeri-collection__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-width: 0;
    height: 24px;
    min-height: 24px;
    margin: 0;
    padding-left: 5px;
    padding-right: 4px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
}

.xeri-collection__title {
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    font-size: 11px;
    height: 22px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.xeri-collection__count {
    font-size: 10px;
    opacity: 0.72;
    -unity-text-align: middle-center;
    height: 22px;
    margin-left: 7px;
    flex-shrink: 0;
}

.xeri-collection__header-spacer {
    flex-grow: 1;
    min-width: 0;
}


.xeri-collection__header-button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 22px;
    min-width: 22px;
    height: 22px;
    min-height: 22px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 12px;
}

.xeri-collection__header-button:hover { background-color: rgba(127,127,127,0.20); }
/* 검색창 외곽 프레임의 크기와 각진 모서리는 Collection Editor가 소유한다. */
.xeri-collection__search {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 23px;
    min-height: 23px;
    margin: 0;
    border-radius: 0;
}

/* 입력 텍스트 내부에 별도로 그려지는 회색 박스만 제거한다.
   외곽 ToolbarSearchField의 테두리·포커스 스타일은 건드리지 않는다. */
.xeri-collection__search .unity-text-input {
    background-color: transparent;
}

.xeri-collection__search .unity-text-element--inner-input-field-component {
    background-color: transparent;
    border-width: 0;
}

.xeri-collection__add-button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 26px;
    min-width: 26px;
    height: 23px;
    min-height: 23px;
    margin-left: 2px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    font-size: 14px;
}

.xeri-collection__add-button:hover { background-color: rgba(127,127,127,0.22); }

/* 데이터 테이블: 헤더와 행은 28px, 콘텐츠는 24px, 버튼은 20px 규격을 공유한다. */
.xeri-collection__rows-host {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    position: relative;
    background-color: rgba(0,0,0,0.09);
}

/* 페이지의 가시 행 높이를 유지하고, 공간 부족 시 Inspector 바깥 스크롤에 맡긴다. */
.xeri-collection #collection-rows {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
}

.xeri-collection__cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
    height: 28px;
    padding-left: 8px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.xeri-collection__row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
    height: 24px;
    margin: 0;
    padding: 0;
}

.xeri-collection__cell-content {
    flex-grow: 1;
    min-width: 0;
    min-height: 24px;
    margin-left: 4px;
    margin-right: 0;
    justify-content: center;
    align-items: stretch;
}

.xeri-collection__reference-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
    height: 24px;
    margin: 0;
    padding: 0;
}

.xeri-collection__data-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 24px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.xeri-collection__cell-content .unity-property-field {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    min-height: 24px;
    height: 24px;
    justify-content: center;
}

.xeri-collection__cell-content .unity-base-field {
    margin: 0;
    padding: 0;
    min-height: 24px;
    height: 24px;
    align-items: center;
}

/* 기본형 입력 영역은 24px 콘텐츠 안에서 20px로 중앙 배치한다. */
.xeri-collection__cell-content .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
    align-self: center;
    margin-top: 0;
    margin-bottom: 0;
}

.xeri-collection__cell-content .unity-base-text-field__input,
.xeri-collection__cell-content .unity-text-input {
    height: 20px;
    min-height: 20px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.xeri-collection__cell-content .unity-text-element--inner-input-field-component {
    height: 100%;
    min-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 11px;
    -unity-text-align: middle-left;
}

/* 아이콘 버튼도 동일한 크기와 툴바 느낌으로 묶는다 */
.xeri-collection__cell-toolbar {
    flex-grow: 0;
    flex-shrink: 0;
    height: 20px;
    min-height: 20px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-left: 6px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
}

/* 셀 동작 세 개와 행 삭제를 하나의 오른쪽 정렬 그룹으로 취급한다. */
.xeri-collection__row-actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 0;
    flex-shrink: 0;
    height: 20px;
    min-height: 20px;
    margin-left: 6px;
    margin-right: 0;
    padding: 0;
}

.xeri-collection__row-actions .xeri-collection__cell-toolbar {
    margin-left: 0;
    margin-right: 0;
}

.xeri-collection__icon-button {
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    -unity-text-align: middle-center;
}
.xeri-collection__icon-button:hover { background-color: rgba(127,127,127,0.22); }
/* Unity Button.iconImage의 자식 이미지를 공통 규격으로 중앙 배치한다. */
.xeri-collection__foldout-button .unity-button__image,
.xeri-collection__header-button .unity-button__image,
.xeri-collection__add-button .unity-button__image,
.xeri-collection__icon-button .unity-button__image {
    width: 11px;
    height: 11px;
    min-width: 11px;
    min-height: 11px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    margin: 0;
    padding: 0;
    --unity-image-size: scale-to-fit;
    --unity-image-tint-color: var(--unity-colors-default-text);
}

.xeri-collection__row-remove:hover { background-color: rgba(198,76,76,0.25); }

.xeri-collection__drag-handle {
    width: 16px;
    min-width: 16px;
    max-width: 16px;
    height: 20px;
    min-height: 20px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    opacity: 0.55;
}

.xeri-collection__drag-icon {
    width: 11px;
    min-width: 11px;
    height: 11px;
    min-height: 11px;
    flex-grow: 0;
    flex-shrink: 0;
    --unity-image-size: scale-to-fit;
    --unity-image-tint-color: var(--unity-colors-default-text);
}

.xeri-collection__drag-handle:hover { opacity: 1; }
.xeri-collection__drag-handle:disabled { opacity: 0.20; }
.xeri-collection__drag-handle--active { opacity: 1; }
.xeri-collection__drag-handle--active .xeri-collection__drag-icon {
    --unity-image-tint-color: rgb(125,177,221);
}

/* 테이블 헤더도 데이터 행과 같은 28px 외곽·24px 콘텐츠·8px 좌우 여백을 쓴다. */
.xeri-collection .unity-multi-column-header {
    height: 28px;
    min-height: 28px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(127,127,127,0.09);
}

.xeri-collection .unity-multi-column-header__column {
    height: 28px;
    min-height: 28px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: flex-start;
}

/* Unity의 헤더 콘텐츠가 컬럼 폭 전체를 차지하도록 맞춘다. */
.xeri-collection .unity-multi-column-header__column__content-container,
.xeri-collection .unity-multi-column-header__column__content,
.xeri-collection .unity-multi-column-header__column__default-content {
    width: 100%;
    min-width: 0;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

/* Column.makeHeader의 컨테이너와 텍스트 배치는 모두 USS에서 지정한다. */
.xeri-collection .xeri-collection__column-header {
    width: 100%;
    min-width: 0;
    height: 24px;
    min-height: 24px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 8px;
    padding-right: 8px;
}

.xeri-collection .xeri-collection__column-header-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 24px;
    min-height: 24px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-text-align: middle-left;
}

.xeri-collection .unity-base-vertical-collection-view__empty-label,
.xeri-collection .unity-collection-view__empty-label,
.xeri-collection .unity-list-view__empty-label,
.xeri-collection .unity-multi-column-list-view__empty-label {
    display: none;
}
.xeri-collection__empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 11px;
    opacity: 0.7;
    white-space: normal;
}

.xeri-collection--multi-column .xeri-collection__empty { top: 28px; }

.xeri-collection--searching .xeri-collection__count {
    opacity: 1;
    -unity-font-style: bold;
}
