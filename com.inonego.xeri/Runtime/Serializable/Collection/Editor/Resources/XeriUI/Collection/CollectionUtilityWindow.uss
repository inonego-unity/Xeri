.xeri-collection-utility {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.xeri-collection-utility--move-index {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.xeri-collection-utility__range-label {
    margin-bottom: 6px;
}

.xeri-collection-utility__actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}
