.managed-reference-input {
    flex-direction: row;
    align-items: center;
    height: 18px;
}

.managed-reference-type {
    flex-grow: 1;
    flex-shrink: 1;
    height: 18px;
    min-width: 120px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.managed-reference-type .unity-button__text {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.managed-reference-icon-button {
    width: 22px;
    height: 18px;
    min-width: 22px;
    margin-left: 2px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    font-size: 16px;
}

.managed-reference-content {
    margin-left: 15px;
    margin-top: 2px;
}
